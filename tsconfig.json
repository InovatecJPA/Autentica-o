{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "outDir": "./dist",
    "strict": true,
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
  },
  "include": [
              "src/**/*",
               "config/config.js"
  ],
  "exclude": ["node_modules"]
}
